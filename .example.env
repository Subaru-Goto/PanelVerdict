# Backend
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=
FRONTEND_ORIGIN=
# Edge gate for the paid endpoints (045/#143). Unset = guard off (local dev).
# The same value goes to the frontend's server-side env — never NEXT_PUBLIC_*.
# (API_URL belongs to the frontend, in frontend/.env.local, not here.)
API_SHARED_SECRET=
OPENROUTER_API_KEY=
MODEL_PROVIDER=

# Sign-in (063/#158). The Supabase project whose session tokens the backend
# verifies, e.g. https://<ref>.supabase.co — public by nature, it is a host.
# Unset = sign-in not configured, and the run limit falls back to counting the
# forwarded address as it did before auth. The frontend needs the same project
# under NEXT_PUBLIC_SUPABASE_URL, in frontend/.env.local.
SUPABASE_PROJECT_URL=
# Elevated, backend-only, used solely to honour an account deletion. Bypasses
# row-level security — never NEXT_PUBLIC_*, never the publishable key. Unset =
# the deletion endpoint reports itself unavailable rather than faking success.
SUPABASE_SERVICE_KEY=

# Spend caps, per day (045/#143). Unset = the derived defaults in config.py
# (3 runs, 30 turns per thread, 120 turns per caller); 0 = that cap off.
# 3, not 25: a prod run costs ~$0.04, so the $1.00 pool below buys ~25 runs for
# the whole day — a per-caller limit of 25 was the entire day handed to one
# person. It only became enforceable with sign-in, since an address costs
# nothing to change and a verified account does not.
EVALUATE_RUNS_PER_DAY=
CHAT_TURNS_PER_THREAD_PER_DAY=
CHAT_TURNS_PER_CALLER_PER_DAY=
# The global daily pool every paid request draws from, in USD (064/#192).
# Unset = $1.00, the signed-off ceiling; 0 = pool off (local iteration).
GLOBAL_DAILY_CAP_USD=

# Optional LangSmith tracing
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_ENDPOINT=
