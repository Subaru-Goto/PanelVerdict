# Backend
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=
FRONTEND_ORIGIN=
# Edge gate for the paid endpoints (045/#143). Unset = guard off (local dev).
# The same value goes to the frontend's server-side env — never NEXT_PUBLIC_*.
# (API_URL belongs to the frontend, in frontend/.env.local, not here.)
API_SHARED_SECRET=
OPENROUTER_API_KEY=
MODEL_PROVIDER=

# Spend caps, per day (045/#143). Unset = the derived defaults in config.py
# (25 runs, 30 turns per thread, 120 turns per caller); 0 = that cap off.
EVALUATE_RUNS_PER_DAY=
CHAT_TURNS_PER_THREAD_PER_DAY=
CHAT_TURNS_PER_CALLER_PER_DAY=

# Optional LangSmith tracing
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_ENDPOINT=
